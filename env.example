# ============================================================
# TEMPLATE ENV — copy thành .env.local để chạy local
#   Mac/Linux:  cp env.example .env.local
#   Windows:    Copy-Item env.example .env.local
# ============================================================

# --- Database ---
# Local (Docker):  mongodb://admin:admin@localhost:27017/quanlyphongtro?authSource=admin
# Atlas (Vercel):  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/quanlyphongtro?retryWrites=true&w=majority
MONGODB_URI=mongodb://admin:admin@localhost:27017/quanlyphongtro?authSource=admin

# --- NextAuth ---
# Local:    http://localhost:3000
# Vercel:   https://<your-project>.vercel.app
NEXTAUTH_URL=http://localhost:3000
# Tạo random: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here

NODE_ENV=development

# --- File Upload (Cloudinary) ---
NEXT_PUBLIC_CLOUD_NAME=
NEXT_PUBLIC_UPLOAD_PRESET=

# --- Email/SMTP (tùy chọn) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Zalo OA (gửi hóa đơn qua Zalo) ---
# Đăng ký tại https://developers.zalo.me/createapp
ZALO_OA_APP_ID=
ZALO_OA_SECRET_KEY=
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_REFRESH_TOKEN=
# UID hiển thị trên zalo.me/<uid> — optional
ZALO_OA_UID=
# Secret cho Vercel Cron auth header
CRON_SECRET=
